{
  "entities": {
    "isgg_students": {
      "title": "ISGG Student",
      "description": "Student profile and enrollment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matricule": { "type": "string", "maxLength": 64 },
        "firstName": { "type": "string", "maxLength": 120 },
        "lastName": { "type": "string", "maxLength": 120 },
        "programId": { "type": "string" },
        "levelId": { "type": "string" },
        "classGroup": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "parentPhone": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "matricule", "firstName", "lastName", "programId", "levelId"]
    },
    "isgg_absences": {
      "title": "ISGG Absence",
      "description": "Individual student absence record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "subjectId": { "type": "string" },
        "absenceDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "timeRange": { "type": "string" },
        "justified": { "type": "boolean" },
        "recordedBy": { "type": "string" }
      },
      "required": ["id", "studentId", "subjectId", "absenceDate"]
    },
    "isgg_programs": {
      "title": "ISGG Program",
      "description": "Academic study department",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string" },
        "availableGroups": { "type": "array" }
      },
      "required": ["id", "code", "name"]
    },
    "isgg_levels": {
      "title": "ISGG Level",
      "description": "Study year level (L1, L2, L3)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    },
    "isgg_subjects": {
      "title": "ISGG Subject",
      "description": "Course subject",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "programId": { "type": "string" },
        "levelId": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "isgg_users": {
      "title": "ISGG User",
      "description": "Staff account with role and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["ADMIN", "SURVEILLANT", "TEACHER", "STUDENT"] },
        "title": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "isgg_notifications": {
      "title": "ISGG Notification",
      "description": "System notices and absence alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "isgg_metadata": {
      "title": "ISGG Metadata",
      "description": "System configuration and academic year details",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/isgg_students/{studentId}": {
      "schema": "isgg_students",
      "description": "Enrolled student profiles"
    },
    "/isgg_absences/{absenceId}": {
      "schema": "isgg_absences",
      "description": "Academic absence events"
    },
    "/isgg_programs/{programId}": {
      "schema": "isgg_programs",
      "description": "Degree programs"
    },
    "/isgg_levels/{levelId}": {
      "schema": "isgg_levels",
      "description": "Year levels"
    },
    "/isgg_subjects/{subjectId}": {
      "schema": "isgg_subjects",
      "description": "Course subjects"
    },
    "/isgg_users/{userId}": {
      "schema": "isgg_users",
      "description": "Authorized staff accounts"
    },
    "/isgg_notifications/{notifId}": {
      "schema": "isgg_notifications",
      "description": "Alerts and notices"
    },
    "/isgg_metadata/{metaId}": {
      "schema": "isgg_metadata",
      "description": "Application state metadata"
    }
  }
}
