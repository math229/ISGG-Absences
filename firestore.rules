rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Students collection
    match /isgg_students/{studentId} {
      allow read: if true;
      allow write: if isValidId(studentId);
    }

    // Absences collection
    match /isgg_absences/{absenceId} {
      allow read: if true;
      allow write: if isValidId(absenceId);
    }

    // Academic Programs
    match /isgg_programs/{programId} {
      allow read: if true;
      allow write: if isValidId(programId);
    }

    // Study Levels
    match /isgg_levels/{levelId} {
      allow read: if true;
      allow write: if isValidId(levelId);
    }

    // Course Subjects
    match /isgg_subjects/{subjectId} {
      allow read: if true;
      allow write: if isValidId(subjectId);
    }

    // Users and Staff directory (Read allowed so authentication and session queries can run)
    match /isgg_users/{userId} {
      allow read: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // System notifications and alerts
    match /isgg_notifications/{notifId} {
      allow read: if true;
      allow write: if isValidId(notifId);
    }

    // Convocations
    match /isgg_convocations/{convocId} {
      allow read: if true;
      allow write: if isValidId(convocId);
    }

    // Import logs and history
    match /isgg_sheet_imports/{importId} {
      allow read: if true;
      allow write: if isValidId(importId);
    }

    // Email OTP Verifications
    match /isgg_email_verifications/{docKey} {
      allow read, write: if isValidId(docKey);
    }

    // Password Reset Requests
    match /isgg_password_resets/{docKey} {
      allow read, write: if isValidId(docKey);
    }

    // Dispatched Emails Audit Logs
    match /isgg_dispatched_emails/{eventId} {
      allow read, write: if isValidId(eventId);
    }

    // Cloud Rate Limiting
    match /isgg_security_ratelimits/{key} {
      allow read, write: if isValidId(key);
    }

    // Banned Clients
    match /isgg_banned_clients/{fingerprint} {
      allow read, write: if isValidId(fingerprint);
    }

    // Security Audits
    match /isgg_security_audits/{auditId} {
      allow read, write: if isValidId(auditId);
    }

    // System Settings & Metadata (accessible by backend server and client configuration)
    match /isgg_metadata/{metaId} {
      allow read, write: if isValidId(metaId);
    }

    // Security codes
    match /isgg_security_codes/{codeId} {
      allow read, write: if isValidId(codeId);
    }
  }
}

